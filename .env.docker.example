APP_NAME="ProfeOpina"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Conexión con contenedor MySQL
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=profeopina
DB_USERNAME=opina_user
DB_PASSWORD=cambiar_password_segura
DB_ROOT_PASSWORD=cambiar_root_password_segura

# Microservicio de IA en Docker
NLP_SERVICE_URL=http://nlp:8001/analizar

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
